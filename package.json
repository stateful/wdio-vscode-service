{
  "name": "wdio-vscode-service",
  "version": "6.1.3",
  "description": "A service to test VSCode extensions from end to end",
  "author": "Christian Bromann <mail@bromann.dev>",
  "homepage": "https://github.com/webdriverio-community/wdio-vscode-service",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typeScriptVersion": "3.8.3",
  "engines": {
    "node": "^16.13 || >=18"
  },
  "scripts": {
    "build": "run-s build:*",
    "build:ts": "tsc -b .",
    "build:compile": "pkg --target win --out-path ./dist/chromium ./dist/chromium/index.js",
    "build:chmod": "chmod +x ./dist/chromium/index.js",
    "ci": "run-s test:lint build test",
    "clean": "rimraf ./node_modules ./dist",
    "docs": "typedoc",
    "prepare": "husky install",
    "release": "release-it --github.release",
    "release:ci": "npm run release -- --ci --npm.skipChecks --no-git.requireCleanWorkingDir",
    "release:patch": "npm run release -- patch",
    "release:minor": "npm run release -- minor",
    "release:major": "npm run release -- major",
    "test": "run-s test:*",
    "test:setup": "node ./.github/scripts/link.mjs",
    "test:lint": "eslint src test",
    "test:e2e": "run-s test:e2e:*",
    "test:e2e:run": "wdio run ./test/wdio.conf.ts",
    "test:e2e:cleanup": "git checkout -- package.json",
    "watch": "npm run build:ts -- --watch"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "wdio-service",
    "vscode",
    "tests"
  ],
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.2",
    "@wdio/logger": "^9.4.4",
    "@xhmikosr/downloader": "^15.0.1",
    "clipboardy": "^4.0.0",
    "decamelize": "6.0.0",
    "fastify": "^5.3.2",
    "get-port": "7.1.0",
    "hpagent": "^1.2.0",
    "slash": "^5.1.0",
    "tmp-promise": "^3.0.3",
    "vscode-uri": "^3.0.8",
    "ws": "^8.18.1",
    "yargs-parser": "^21.1.1"
  },
  "peerDependencies": {
    "webdriverio": "^9.12.7"
  },
  "peerDependenciesMeta": {
    "webdriverio": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/download": "^8.0.5",
    "@types/node": "^20.17.31",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@wdio/cli": "^9.12.7",
    "@wdio/globals": "^9.12.7",
    "@wdio/local-runner": "^9.12.7",
    "@wdio/mocha-framework": "^9.12.6",
    "@wdio/spec-reporter": "^9.12.6",
    "@wdio/types": "^9.12.6",
    "eslint": "^9.25.1",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unicorn": "^58.0.0",
    "eslint-plugin-wdio": "^9.9.1",
    "expect-webdriverio": "^5.1.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^7.0.2",
    "pkg": "^5.8.1",
    "release-it": "^19.0.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.3",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist/*",
    "src/server/fs-provider"
  ]
}
